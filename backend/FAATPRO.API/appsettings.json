{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=faatpro_db;Username=admin;Password=password"
  },

  "JwtSettings": {
    "SecretKey": "FAATPRO_ACCOUNTING_SECRET_KEY_2026_SECURE_KEY",
    "Issuer": "FAATPRO.API",
    "Audience": "FAATPRO.Client",
    "ExpiryMinutes": 60
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}